{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poad.io/schema/connectors/credential.schema.json",
  "title": "Type d'identifiant poad",
  "description": "Décrit les champs d'un type d'identifiant (connexion à une base, clé d'API...). Le fichier s'appelle credentials/<type>.json.",
  "type": "object",
  "required": ["type", "name", "fields"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "x-message": "type invalide : minuscules, chiffres et tirets, commence par une lettre"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "kind"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "x-message": "clé de champ invalide : minuscules, chiffres et soulignés, commence par une lettre"
          },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["text", "number", "boolean", "secret"] },
          "required": { "type": "boolean" },
          "default": {
            "description": "Valeur par défaut, du type de « kind ». Interdite pour un secret.",
            "type": ["string", "number", "boolean"]
          },
          "help": { "type": "string" }
        }
      }
    }
  }
}
